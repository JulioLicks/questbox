             back:`<strong>Manter conhecido</strong><br>Atualize com pesquisas.`},
            {code:"F14",title:"Fornecedores",cat:"diagnostico",dur:5,xp:5,
             front:`<strong>Suprimentos</strong><br>Lista de fornecedores e itens.<br><br><strong>Exemplo:</strong> "Papelaria XYZ - R$500/mês"`,
             back:`<strong>Reposição</strong><br>Planeje pedidos com antecedência.`},
            {code:"F15",title:"Produtos",cat:"diagnostico",dur:5,xp:5,
             front:`<strong>Oferecidos ao público</strong><br>Descrição, preço, composição.<br><br><strong>Exemplo:</strong> "Camiseta - R$50 - 100% algodão"`,
             back:`<strong>Composição</strong><br>Detalhe materiais e custos.`},
            {code:"F16",title:"Serviços",cat:"diagnostico",dur:5,xp:5,
             front:`<strong>Ações sem produto físico</strong><br>Consultoria, aula, entrega.<br><br><strong>Exemplo:</strong> "Consultoria de 1h - R$200"`,
             back:`<strong>Sem produto físico</strong><br>Defina escopo e duração.`},
            {code:"F17",title:"Áreas",cat:"diagnostico",dur:5,xp:5,
             front:`<strong>Regiões ou disciplinas</strong><br>Setores de atuação.<br><br><strong>Exemplo:</strong> "Marketing Digital", "Vendas"`,
             back:`<strong>Setores ou disciplinas</strong><br>Organize por área de conhecimento.`},
            {code:"F18",title:"Ambiente",cat:"diagnostico",dur:5,xp:5,
             front:`<strong>Local de trabalho</strong><br>Descreva o espaço físico.<br><br><strong>Exemplo:</strong> "Sala com 4 mesas, internet 100MB"`,
             back:`<strong>Áreas menores</strong><br>Detalhe condições de trabalho.`},

            // === PLANEJAMENTO (F19-F36) ===
            {code:"F19",title:"Ideias",cat:"planejamento",dur:5,xp:5,
             front:`<strong>Visões iniciais</strong><br>Gere ideias sem julgamento.<br><br><strong>Técnica:</strong> Brainstorming`,
             back:`<strong>Sem julgamento</strong><br>Anote todas as ideias, mesmo as "malucas".`},
            {code:"F20",title:"Propostas",cat:"planejamento",dur:5,xp:5,
             front:`<strong>Soluções viáveis</strong><br>Transforme ideias em propostas concretas.<br><br><strong>Exemplo:</strong> "Criar curso online"`,
             back:`<strong>Declaração de valor</strong><br>Explique o benefício da proposta.`},
            {code:"F21",title:"Conteúdos",cat:"planejamento",dur:5,xp:5,
             front:`<strong>Sumários e scripts</strong><br>Roteiros, textos, apresentações.<br><br><strong>Exemplo:</strong> Script de vendas`,
             back:`<strong>Scripts</strong><br>Padronize mensagens importantes.`},
            {code:"F22",title:"Canais",cat:"planejamento",dur:5,xp:5,
             front:`<strong>Meios de comunicação</strong><br>Redes sociais, e-mail, WhatsApp.<br><br><strong>Exemplo:</strong> Instagram, YouTube`,
             back:`<strong>Slides ou mídias</strong><br>Escolha os canais mais eficazes.`},
            {code:"F23",title:"Recursos",cat:"planejamento",dur:5,xp:5,
             front:`<strong>Necessários para o projeto</strong><br>Lista de materiais, equipamentos, software.<br><br><strong>Exemplo:</strong> "Computador, câmera"`,
             back:`<strong>Materiais</strong><br>Planeje aquisição com antecedência.`},
            {code:"F24",title:"Cronograma",cat:"planejamento",dur:5,xp:5,
             front:`<strong>Tempo total do projeto</strong><br>Divida em semanas ou meses.<br><br><strong>Exemplo:</strong> Semana 1: Diagnóstico`,
             back:`<strong>Prazos</strong><br>Defina datas para cada fase.`},
            {code:"F25",title:"Custos",cat:"planejamento",dur:5,xp:5,
             front:`<strong>Orçamentos</strong><br>Lista de despesas previstas.<br><br><strong>Exemplo:</strong> "Marketing: R$1.000"`,
             back:`<strong>Precificação</strong><br>Calcule custo total do projeto.`},
            {code:"F26",title:"Receitas",cat:"planejamento",dur:5,xp:5,
             front:`<strong>Fontes de lucro</strong><br>Vendas, assinaturas, patrocínios.<br><br><strong>Exemplo:</strong> "Venda de produto: R$5.000"`,
             back:`<strong>Fontes de lucro</strong><br>Projetar faturamento mensal.`},
            {code:"F27",title:"Metas",cat:"planejamento",dur:5,xp:5,
             front:`<strong>Objetivos secundários</strong><br>Use critérios SMART.<br><br><strong>Exemplo:</strong> "Vender 100 unidades em 30 dias"`,
             back:`<strong>Critérios SMART</strong><br>Específica, Mensurável, Alcançável, Relevante, Temporal.`},
            {code:"F28",title:"Estratégias",cat:"planejamento",dur:5,xp:5,
             front:`<strong>Cenários de ação</strong><br>Plano A, Plano B.<br><br><strong>Exemplo:</strong> "Se não vender, oferecer desconto"`,
             back:`<strong>Ações</strong><br>Defina gatilhos e respostas.`},
            {code:"F29",title:"Riscos",cat:"planejamento",dur:5,xp:5,
             front:`<strong>Objeções e problemas</strong><br>Liste possíveis falhas.<br><br><strong>Exemplo:</strong> "Falta de cliente"`,
             back:`<strong>Evitar problemas</strong><br>Crie plano de contingência.`},
            {code:"F30",title:"Oportunidades",cat:"planejamento",dur:5,xp:5,
             front:`<strong>Chances de sucesso</strong><br>Identifique brechas no mercado.<br><br><strong>Exemplo:</strong> "Nova tendência"`,
             back:`<strong>Aproveitar</strong><br>Planeje como explorar a oportunidade.`},
            {code:"F31",title:"Metodologia",cat:"planejamento",dur:5,xp:5,
             front:`<strong>Método aplicado</strong><br>Passo a passo do processo.<br><br><strong>Exemplo:</strong> Scrum, Kanban`,
             back:`<strong>Etapas</strong><br>Documente o fluxo de trabalho.`},
            {code:"F32",title:"Pesquisas",cat:"planejamento",dur:5,xp:5,
             front:`<strong>Colher dados</strong><br>Fontes: entrevistas, questionários, internet.<br><br><strong>Exemplo:</strong> "Pesquisa de mercado"`,
             back:`<strong>Fontes</strong><br>Registre onde obteve os dados.`},
            {code:"F33",title:"Referências",cat:"planejamento",dur:5,xp:5,
             front:`<strong>Fontes consultadas</strong><br>Livros, artigos, sites.<br><br><strong>Exemplo:</strong> "Livro X, 2020"`,
             back:`<strong>Autor e data</strong><br>Use formato ABNT ou APA.`},
            {code:"F34",title:"Indicadores",cat:"planejamento",dur:5,xp:5,
             front:`<strong>Números importantes</strong><br>KPI's: vendas, engajamento, satisfação.<br><br><strong>Exemplo:</strong> "Taxa de conversão: 5%"`,
             back:`<strong>Tendências</strong><br>Defina metas para cada indicador.`},
            {code:"F35",title:"Acordos",cat:"planejamento",dur:5,xp:5,
             front:`<strong>Termos negociados</strong><br>Contratos, parcerias.<br><br><strong>Exemplo:</strong> "Parceria com influenciador"`,
             back:`<strong>Negociação</strong><br>Registre condições acordadas.`},
            {code:"F36",title:"Instruções",cat:"planejamento",dur:5,xp:5,
             front:`<strong>Regras e receitas</strong><br>Passo a passo para tarefas.<br><br><strong>Exemplo:</strong> "Como fazer um post"`,
             back:`<strong>Receitas</strong><br>Padronize processos repetitivos.`},

            // === REALIZAÇÃO (F37-F54) ===
            {code:"F37",title:"Ficha de Atendimento",cat:"realizacao",dur:5,xp:5,
             front:`<strong>Registro de cliente</strong><br>Nome, contato, necessidade, solução oferecida.<br><br><strong>Campos adicionais:</strong> Data, status`,
             back:`<strong>Campos adicionais</strong><br>Use para acompanhar o funil de vendas.`},
            {code:"F38",title:"Contatos",cat:"realizacao",dur:5,xp:5,
             front:`<strong>Lista de contatos</strong><br>Nome, telefone, e-mail, última interação.<br><br><strong>Exemplo:</strong> "Maria - 11 99999-9999"`,
             back:`<strong>Agendar reuniões</strong><br>Mantenha atualizado.`},
            {code:"F39",title:"Agenda",cat:"realizacao",dur:5,xp:5,
             front:`<strong>Compromissos agendados</strong><br>Data, hora, atividade, responsável.<br><br><strong>Exemplo:</strong> "10/10 - Reunião - João"`,
             back:`<strong>Eventos</strong><br>Sincronize com calendário.`},
            {code:"F40",title:"Reuniões",cat:"realizacao",dur:5,xp:5,
             front:`<strong>Atas de reunião</strong><br>Objetivo, participantes, decisões, tarefas.<br><br><strong>Exemplo:</strong> "Aprovado orçamento"`,
             back:`<strong>Objetivos</strong><br>Registre tudo por escrito.`},
            {code:"F41",title:"Feedbacks e Resultados",cat:"realizacao",dur:5,xp:5,
             front:`<strong>Pesquisa de satisfação</strong><br>Notas, comentários, sugestões.<br><br><strong>Exemplo:</strong> "Nota 8 - Entrega rápida"`,
             back:`<strong>Pesquisa</strong><br>Colete feedback regularmente.`},
            {code:"F42",title:"Contrato",cat:"realizacao",dur:5,xp:5,
             front:`<strong>Termos negociados</strong><br>Partes, objeto, valor, prazo, condições.<br><br><strong>Exemplo:</strong> "Serviço de R$1.000"`,
             back:`<strong>Termos</strong><br>Assinatura de ambas as partes.`},
            {code:"F43",title:"Tarefas",cat:"realizacao",dur:5,xp:5,
             front:`<strong>Ações a serem executadas</strong><br>Descrição, responsável, prazo, status.<br><br><strong>Progresso:</strong> [ ] [ ] [ ] [ ] [ ]`,
             back:`<strong>Progresso</strong><br>Marcar bolinhas conforme avanço.`},
            {code:"F44",title:"Interdependências",cat:"realizacao",dur:5,xp:5,
             front:`<strong>Tarefas que dependem de outras</strong><br>Use números para conectar.<br><br><strong>Exemplo:</strong> Tarefa 2 → após Tarefa 1`,
             back:`<strong>Números</strong><br>Organize a sequência lógica.`},
            {code:"F45",title:"Rotinas",cat:"realizacao",dur:5,xp:5,
             front:`<strong>Tarefas periódicas</strong><br>Diárias, semanais, mensais.<br><br><strong>Exemplo:</strong> "Postar nas redes - toda segunda"`,
             back:`<strong>Administrativas</strong><br>Automatize o que for possível.`},
            {code:"F46",title:"Treinamentos",cat:"realizacao",dur:5,xp:5,
             front:`<strong>Capacitação da equipe</strong><br>Tema, duração, instrutor, participantes.<br><br><strong>Exemplo:</strong> "Vendas - 2h - Ana"`,
             back:`<strong>Passos</strong><br>Registre presença e avaliação.`},
            {code:"F47",title:"Lista de Presenças",cat:"realizacao",dur:5,xp:5,
             front:`<strong>Controle de frequência</strong><br>Nome, data, presença.<br><br><strong>Exemplo:</strong> "João - 10/10 - Presente"`,
             back:`<strong>Frequência</strong><br>Identifique ausências recorrentes.`},
            {code:"F48",title:"Avaliação",cat:"realizacao",dur:5,xp:5,
             front:`<strong>Desempenho da equipe</strong><br>Notas de 1 a 5 em critérios.<br><br><strong>Pontos:</strong> [ ] [ ] [ ] [ ] [ ]`,
             back:`<strong>Pontos</strong><br>Dê feedback construtivo.`},
            {code:"F49",title:"Caixa",cat:"realizacao",dur:5,xp:5,
             front:`<strong>Controle financeiro</strong><br>Entradas, saídas, saldo.<br><br><strong>Exemplo:</strong> "Entrada: R$1.000 - Venda"`,
             back:`<strong>Entradas/saídas</strong><br>Registre diariamente.`},
            {code:"F50",title:"Inventário",cat:"realizacao",dur:5,xp:5,
             front:`<strong>Bens da empresa</strong><br>Item, quantidade, localização.<br><br><strong>Exemplo:</strong> "Mesa - 4 - Sala 1"`,
             back:`<strong>Extravios</strong><br>Faça contagem periódica.`},
            {code:"F51",title:"Estoque",cat:"realizacao",dur:5,xp:5,
             front:`<strong>Produtos para venda</strong><br>Item, quantidade, preço.<br><br><strong>Exemplo:</strong> "Camiseta - 50 - R$50"`,
             back:`<strong>Alinhar demandas</strong><br>Evite rupturas ou excessos.`},
            {code:"F52",title:"Logística",cat:"realizacao",dur:5,xp:5,
             front:`<strong>Entrega de produtos</strong><br>Origem, destino, prazo, transportadora.<br><br><strong>Exemplo:</strong> "SP → RJ - 3 dias"`,
             back:`<strong>Origem/destino</strong><br>Acompanhe em tempo real.`},
            {code:"F53",title:"Suporte",cat:"realizacao",dur:5,xp:5,
             front:`<strong>Atendimento pós-venda</strong><br>Problema, solução, satisfação.<br><br><strong>Exemplo:</strong> "Troca de produto"`,
             back:`<strong>Feedbacks</strong><br>Resolva rapidamente.`},
            {code:"F54",title:"Manutenção",cat:"realizacao",dur:5,xp:5,
             front:`<strong>Conservação de equipamentos</strong><br>Item, problema, responsável, data.<br><br><strong>Exemplo:</strong> "Computador - Tela quebrada - TI"`,
             back:`<strong>Problema e responsável</strong><br>Programe manutenções preventivas.`}
        ];

        // === GERAR MATRIZ ===
        const grid = document.getElementById('matrix-grid');
        const categories = {
            ajuda: cards.filter(c => c.cat === 'ajuda').map(c => c.code),
            desafio: cards.filter(c => c.cat === 'desafio').map(c => c.code),
            gerenciamento: cards.filter(c => c.cat === 'gerenciamento').map(c => c.code),
            diagnostico: cards.filter(c => c.cat === 'diagnostico').map(c => c.code),
            planejamento: cards.filter(c => c.cat === 'planejamento').map(c => c.code),
            realizacao: cards.filter(c => c.cat === 'realizacao').map(c => c.code)
        };

        Object.entries(categories).forEach(([cat, codes]) => {
            const row = document.createElement('div');
            row.className = 'matrix-row';
            codes.forEach(code => {
                const cell = document.createElement('div');
                cell.textContent = code;
                const card = cards.find(c => c.code === code);
                cell.className = `matrix-cell cat-${card.cat}`;
                cell.onclick = () => showCard(code);
                row.appendChild(cell);
            });
            grid.appendChild(row);
        });

        // === PREENCHER LISTAS ===
        const lists = {
            ajuda: document.getElementById('list-ajuda'),
            desafio: document.getElementById('list-desafio'),
            gerenciamento: document.getElementById('list-gerenciamento'),
            diagnostico: document.getElementById('list-diagnostico'),
            planejamento: document.getElementById('list-planejamento'),
            realizacao: document.getElementById('list-realizacao')
        };

        cards.forEach(c => {
            const div = document.createElement('div');
            div.className = 'card-item';
            div.innerHTML = `
                <div class="card-circle">${c.code}</div>
                <div class="card-text">
                    <strong>${c.title}</strong>
                    <small>${c.front.replace(/<[^>]*>/g, '').substring(0, 60)}...</small>
                </div>
            `;
            div.onclick = () => showCard(c.code);
            lists[c.cat].appendChild(div);
        });

        // === MOSTRAR CARD COM CONTEÚDO COMPLETO ===
        function showCard(code) {
            const card = cards.find(c => c.code === code);
            const header = document.getElementById('card-header');
            let bgColor = '#e67e22';
            if (card.cat === 'ajuda') bgColor = '#f39c12';
            else if (card.cat === 'desafio') bgColor = '#27ae60';
            else if (card.cat === 'gerenciamento') bgColor = '#9b59b6';
            else if (card.cat === 'diagnostico') bgColor = '#e74c3c';
            else if (card.cat === 'planejamento') bgColor = '#f1c40f';
            else if (card.cat === 'realizacao') bgColor = '#1e88e5';
            header.style.background = bgColor;

            document.getElementById('code-circle').textContent = card.code;
            document.getElementById('card-title-text').textContent = card.title;
            document.getElementById('front-content').innerHTML = card.front;
            document.getElementById('back-content').innerHTML = card.back;
            document.getElementById('card-detail').classList.add('active');
            window.scrollTo({top: document.getElementById('card-detail').offsetTop - 100, behavior: 'smooth'});
        }

        function closeCard() {
            document.getElementById('card-detail').classList.remove('active');
        }

        // === ROLAGEM SUAVE PARA SEÇÕES ===
        function smoothScroll(target) {
            event.preventDefault();
            const element = document.querySelector(target);
            const headerOffset = 90;
            const elementPosition = element.getBoundingClientRect().top + window.pageYOffset;
            const offsetPosition = elementPosition - headerOffset;

            window.scrollTo({
                top: offsetPosition,
                behavior: 'smooth'
            });
        }

        // === RESETAR BORDA DO HEADER AO SAIR DO HOVER ===
        document.querySelectorAll('.index-nav a').forEach(link => {
            link.addEventListener('mouseleave', () => {
                document.getElementById('main-header').style.borderBottomColor = '#e67e22';
            });
        });
    </script>

</body>
</html>
